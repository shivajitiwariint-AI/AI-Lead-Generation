# Application
DATABASE_URL="mysql://root:root@localhost:3306/ai_lead_gen?schema=public"
AUTH_SECRET="change-this-to-a-random-32-char-secret"
APP_URL=http://localhost:3000

# Credential encryption (32+ chars required)
CREDENTIAL_ENCRYPTION_KEY="change-this-to-32-char-key!!"
CRON_SECRET="change-this-cron-secret"
INGEST_API_KEY="change-this-ingest-token-32chars-min"
WEBHOOK_SECRET="change-this-webhook-hmac-secret-32chars"
# Redis (shared rate limits across instances) — leave blank to use in-memory fallback
REDIS_URL="redis://localhost:6379"

# AI provider keys (platform bootstrap - get your own)
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Ollama (separately hosted, not localhost in production)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# Email & WhatsApp
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Object storage (S3-compatible - for local use MinIO or leave blank)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Monitoring
SENTRY_DSN=
